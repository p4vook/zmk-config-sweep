#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

#define L_EN     0
#define L_RU     1
#define L_SYM_EN 2
#define L_SYM_RU 3
#define L_NAV    4
#define L_CTRL   5

/ {
    behaviors {
        // Positional "timeless" home-row mods (left hand triggers on right keys + thumbs)
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Positional "timeless" home-row mods (right hand triggers on left keys + thumbs)
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Balanced thumb layer-tap (prevents accidental ESC/ENTER on fast layer taps)
        lth: layer_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        control_en {
            if-layers = <L_SYM_EN L_NAV>;
            then-layer = <L_CTRL>;
        };

        control_ru {
            if-layers = <L_SYM_RU L_NAV>;
            then-layer = <L_CTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // --- Shared system combos ---
        tab {
            bindings = <&kp TAB>;
            key-positions = <0 10>;
            layers = <L_EN L_RU>;
        };

        ru_en {
            bindings = <&lang_switch>;
            key-positions = <14 24>;  // D+K (EN) / М+Ж (RU)
            layers = <L_EN L_RU>;
        };

        // --- Left-hand letter & CLI combos (EN) ---
        en_at {
            bindings = <&kp AT>;      // @ (left ring upper, QWERTY 2/@)
            key-positions = <1 11>;
            layers = <L_EN>;
        };

        en_j {
            bindings = <&kp J>;
            key-positions = <3 13>;
            layers = <L_EN>;
        };

        en_tilde {
            bindings = <&kp TILDE>;   // ~ (left pinky lower, rolls into pinky / for ~/)
            key-positions = <10 20>;
            layers = <L_EN>;
        };

        en_q {
            bindings = <&kp Q>;       // Q (left ring lower)
            key-positions = <11 21>;
            layers = <L_EN>;
        };

        en_caret {
            bindings = <&kp CARET>;   // ^
            key-positions = <13 23>;
            layers = <L_EN>;
        };

        // --- Left-hand letter combos (RU: all extra Cyrillic letters on left hand) ---
        ru_tse {
            bindings = <&kp W>;       // Ц
            key-positions = <1 11>;
            layers = <L_RU>;
        };

        ru_shcha {
            bindings = <&kp O>;       // Щ
            key-positions = <2 12>;
            layers = <L_RU>;
        };

        ru_hard {
            bindings = <&kp RBKT>;    // Ъ
            key-positions = <11 21>;
            layers = <L_RU>;
        };

        // --- Right-hand language-independent punctuation combos (EN & RU) ---
        // Top+Home (5..9):    !   :   "   (   )   (QWERTY 9=( 0=) on cols 8, 9)
        // Home+Bot (15..19):  -   =   ,   .   ?   (QWERTY , . ? on cols 7, 8, 9)

        punc_excl {
            bindings = <&kp EXCLAMATION>; // ! (EN & RU)
            key-positions = <5 15>;
            layers = <L_EN L_RU>;
        };

        punc_colon_en {
            bindings = <&kp COLON>;       // : (EN)
            key-positions = <6 16>;
            layers = <L_EN>;
        };

        punc_colon_ru {
            bindings = <&kp CARET>;       // : (RU ЙЦУКЕН = Shift+6)
            key-positions = <6 16>;
            layers = <L_RU>;
        };

        punc_dqt_en {
            bindings = <&kp DOUBLE_QUOTES>; // " (EN)
            key-positions = <7 17>;
            layers = <L_EN>;
        };

        punc_dqt_ru {
            bindings = <&kp AT>;          // " (RU ЙЦУКЕН = Shift+2)
            key-positions = <7 17>;
            layers = <L_RU>;
        };

        punc_lpar {
            bindings = <&kp LEFT_PARENTHESIS>; // ( (EN & RU, QWERTY col 8)
            key-positions = <8 18>;
            layers = <L_EN L_RU>;
        };

        punc_rpar {
            bindings = <&kp RIGHT_PARENTHESIS>; // ) (EN & RU, QWERTY col 9)
            key-positions = <9 19>;
            layers = <L_EN L_RU>;
        };

        punc_minus {
            bindings = <&kp MINUS>;       // - (EN & RU)
            key-positions = <15 25>;
            layers = <L_EN L_RU>;
        };

        punc_equal {
            bindings = <&kp EQUAL>;       // = (EN & RU)
            key-positions = <16 26>;
            layers = <L_EN L_RU>;
        };

        punc_comma_en {
            bindings = <&kp COMMA>;       // , (EN, QWERTY col 7)
            key-positions = <17 27>;
            layers = <L_EN>;
        };

        punc_comma_ru {
            bindings = <&kp QUESTION>;    // , (RU ЙЦУКЕН = Shift+/, QWERTY col 7)
            key-positions = <17 27>;
            layers = <L_RU>;
        };

        punc_dot_en {
            bindings = <&kp DOT>;         // . (EN, QWERTY col 8)
            key-positions = <18 28>;
            layers = <L_EN>;
        };

        punc_dot_ru {
            bindings = <&kp FSLH>;        // . (RU ЙЦУКЕН = /, QWERTY col 8)
            key-positions = <18 28>;
            layers = <L_RU>;
        };

        punc_qmark_en {
            bindings = <&kp QUESTION>;    // ? (EN, QWERTY col 9)
            key-positions = <19 29>;
            layers = <L_EN>;
        };

        punc_qmark_ru {
            bindings = <&kp AMPS>;        // ? (RU ЙЦУКЕН = Shift+7, QWERTY col 9)
            key-positions = <19 29>;
            layers = <L_RU>;
        };

        // --- SYM_EN extra combos ---
        sym_caret {
            bindings = <&kp CARET>;       // ^
            key-positions = <15 25>;
            layers = <L_SYM_EN>;
        };

        sym_at {
            bindings = <&kp AT>;          // @
            key-positions = <17 27>;
            layers = <L_SYM_EN>;
        };
    };

    macros {
        lang_switch: lang_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &tog L_RU>;
            label = "LANG_SWITCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        EN {
            bindings = <
&kp W        &kp B        &kp G         &kp L            &kp M        &kp X          &kp F         &kp O         &kp Y        &kp SQT
&hml LGUI R  &hml LALT N  &hml LCTRL S  &hml LSHFT T     &kp D        &kp U          &hmr RSHFT A  &hmr RCTRL E  &hmr RALT I  &hmr RGUI H
&kp Z        &kp P        &kp C         &kp V            &kp K        &kp MINUS      &kp SEMI      &kp COMMA     &kp DOT      &kp FSLH
                                        &lth L_SYM_EN ESC &kp SPACE   &kp BACKSPACE  &lth L_NAV ENTER
            >;
        };

        RU {
            bindings = <
&kp P        &kp COMMA        &kp L         &kp H            &kp U     &kp DOT    &kp E         &kp F         &kp G        &kp M
&hml LGUI C  &hml LALT N      &hml LCTRL R  &hml LSHFT Y     &kp V     &kp Q      &hmr RSHFT T  &hmr RCTRL J  &hmr RALT D  &hmr RGUI B
&kp I        &kp LEFT_BRACKET &kp X         &kp K            &kp SEMI  &kp GRAVE  &kp Z         &kp S         &kp A        &kp SQT
                                            &lth L_SYM_RU ESC &trans   &trans     &trans
            >;
        };

        SYM_EN {
            bindings = <
&kp BSLH        &kp HASH       &kp LBRC            &kp RBRC                 &kp PIPE     &kp DOT    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COMMA          &kp DOLLAR
&hml LGUI LBKT  &hml LALT RBKT &hml LCTRL PERCENT  &hml LSHFT DOUBLE_QUOTES &kp GRAVE    &kp COLON  &hmr RSHFT UNDERSCORE &hmr RCTRL STAR        &hmr RALT QUESTION &hmr RGUI SQT
&kp SEMI        &kp AMPS       &kp EXCLAMATION     &kp TILDE                &kp EQUAL    &kp MINUS  &kp FSLH              &kp PLUS               &kp LESS_THAN      &kp GREATER_THAN
                                                   &trans                   &trans       &trans     &trans
            >;
        };

        SYM_RU {
            bindings = <
&kp BSLH        &kp HASH       &none               &none               &none        &kp FSLH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION      &none
&kp LGUI        &kp LALT       &hml LCTRL PERCENT  &hml LSHFT AT       &none        &kp CARET  &hmr RSHFT UNDERSCORE &hmr RCTRL STAR        &hmr RALT AMPS    &kp RGUI
&kp DOLLAR      &none          &kp EXCLAMATION     &none               &kp EQUAL    &kp MINUS  &kp PIPE              &kp PLUS               &none             &none
                                                   &trans              &trans       &trans     &trans
            >;
        };

        NAV {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &trans    &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp DEL
&trans  &kp N4  &kp N5  &kp N6  &trans    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp BSPC
&trans  &kp N7  &kp N8  &kp N9  &trans    &trans     &trans    &trans    &trans     &trans
                        &trans  &kp N0    &trans     &trans
            >;
        };

        CONTROL {
            bindings = <
&sys_reset      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &none   &none  &none  &sys_reset      &bt BT_NXT
&bootloader     &tog L_RU     &none         &none         &none           &none   &none  &none  &bootloader     &bt BT_PRV
&studio_unlock  &none         &none         &none         &none           &none   &none  &none  &studio_unlock  &bt BT_CLR
                                            &trans        &none           &none   &trans
            >;
        };
    };
};
